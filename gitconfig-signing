# Signing settings for public repositories.
# Loaded by includeIf entries in ~/.gitconfig-signing-includes,
# generated by bin/gen-git-signing-config.sh.
#
# The global default (~/.gitconfig) disables signing so unattended agent commits
# do not block on 1Password biometric authentication prompts.
# This file re-enables signing for public repositories only.
#
# tag.gpgsign is intentionally unset, as before: tags remain unsigned.
# Enabling it would block tag creation by semantic-release and similar tools
# while waiting for a 1Password prompt.
[commit]
    gpgsign = true
