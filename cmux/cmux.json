{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // Primary cmux configuration. Include only customized settings, without the
  // commented-out template that cmux generates automatically.
  // Legacy settings.json is retired (cmux.json is primary in v0.64+).
  // Apply edits with `cmux reload-config` (also reloads Ghostty configuration).

  "app": {
    // Open files (for example, Cmd+click) in the macOS default app instead of a cmux preview
    "openSupportedFilesInCmux": false
  },

  "sidebar": {
    // Open Port / PR links in the default browser instead of the built-in browser
    "openPortLinksInCmuxBrowser": false,
    "openPullRequestLinksInCmuxBrowser": false,
    "showBranchDirectory": false,
    "showCustomMetadata": true
  },

  "browser": {
    // Send terminal URL clicks and the `open` command to the default browser
    "interceptTerminalOpenCommandInCmuxBrowser": false,
    "openTerminalLinksInCmuxBrowser": false
  },

  "automation": {
    // false: the built-in workspace-level claude_code pill (Running/Awaiting) can
    // get stuck at Awaiting when several panes run in the same workspace.
    // This is a known upstream bug (issue #1027 / PR #5666): turnId drift gates
    // the clearing event. The fix is unmerged, so this repository cannot fix it.
    // The only reason for enabling it was ~/.cmuxterm/claude-hook-sessions.json
    // (the sessionId -> surface/workspace UUID map consumed by ccdash and
    // issues-site). plugins/cmux/hooks/scripts/claude-status-hook.sh now
    // generates its own map at ~/.claude/cmux/hook-sessions.json, so there is
    // no remaining reason to keep it true (SETUP-3, option 1). Setting false
    // also disables automatic workspace titles and the latest-message display.
    // Per-pane display uses the cwd_<panel-id> pills managed by claude-status-hook.sh.
    // This setting is evaluated only when creating a surface: Claude sessions in
    // existing panes retain the old behavior until those panes are reopened.
    "claudeCodeIntegration": false,
    "socketControlMode": "automation"
  },

  "shortcuts": {
    "bindings": {
      "browserBack": "cmd+[",
      "browserForward": "cmd+]",
      "browserReload": "cmd+r",
      "browserZoomIn": "cmd+=",
      "browserZoomOut": "cmd+-",
      "browserZoomReset": "cmd+0",
      "closeOtherTabsInPane": "cmd+opt+t",
      "closeTab": "cmd+w",
      "closeWindow": "cmd+ctrl+w",
      "closeWorkspace": "cmd+shift+w",
      "commandPalette": "cmd+shift+p",
      "editWorkspaceDescription": "cmd+shift+e",
      "find": "cmd+f",
      "findNext": "cmd+g",
      "findPrevious": "cmd+opt+g",
      "focusBrowserAddressBar": "cmd+l",
      // Explicitly retain the old keys to avoid conflicts with v0.64+ defaults (cmd+opt+down, etc.)
      "focusDown": "cmd+↓",
      "focusLeft": "cmd+←",
      "focusRight": "cmd+→",
      "focusUp": "cmd+↑",
      // Disable new v0.64+ defaults that conflict with browserBack/Forward (cmd+[/])
      "focusHistoryBack": null,
      "focusHistoryForward": null,
      // Disable the new v0.64+ default that conflicts with editWorkspaceDescription (cmd+shift+e)
      "focusRightSidebar": null,
      "goToWorkspace": "cmd+p",
      "hideFind": "cmd+shift+f",
      "jumpToUnread": "cmd+shift+u",
      "newSurface": "cmd+t",
      "newTab": "cmd+n",
      "newWindow": "cmd+shift+n",
      // Workspace navigation: cmd+alt+down/up. Since v0.64.16 (#6007), Option alone
      // goes to the terminal first and never triggers cmux shortcuts, even when Ghostty suppresses it.
      // This pairs vertical workspace navigation with horizontal cmd+alt+left/right surface navigation.
      "nextSidebarTab": "cmd+alt+↓",
      "nextSurface": "cmd+alt+→",
      "openBrowser": "cmd+shift+l",
      "openFolder": "cmd+o",
      "openSettings": "cmd+,",
      "prevSidebarTab": "cmd+alt+↑",
      "prevSurface": "cmd+alt+←",
      "quit": "cmd+q",
      "reloadConfiguration": "cmd+shift+,",
      "renameTab": "cmd+r",
      "renameWorkspace": "cmd+shift+r",
      "reopenClosedBrowserPanel": "cmd+shift+t",
      "selectSurfaceByNumber": "ctrl+1",
      "selectWorkspaceByNumber": "cmd+1",
      "sendFeedback": "cmd+opt+f",
      "showBrowserJavaScriptConsole": "cmd+opt+c",
      "showNotifications": "cmd+i",
      "splitBrowserDown": "cmd+shift+opt+d",
      "splitBrowserRight": "cmd+opt+d",
      "splitDown": "cmd+shift+d",
      "splitRight": "cmd+d",
      "toggleBrowserDeveloperTools": "cmd+opt+i",
      "toggleFullScreen": "cmd+ctrl+f",
      "toggleReactGrab": "cmd+shift+g",
      "toggleSidebar": "cmd+b",
      "toggleSplitZoom": "cmd+enter",
      "toggleTerminalCopyMode": "cmd+shift+m",
      "triggerFlash": "cmd+shift+h",
      "useSelectionForFind": "cmd+e"
    },
    "showModifierHoldHints": true
  }
}
