{
  "cmux-status": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "sh -c 'hook=\"./hooks/scripts/claude-status-hook.sh\"; [ -x \"$hook\" ] && \"$hook\" running; echo \"{}\"'",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh -c 'hook=\"./hooks/scripts/claude-status-hook.sh\"; [ -x \"$hook\" ] && \"$hook\" idle; echo \"{}\"'",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'hook=\"./hooks/scripts/claude-status-hook.sh\"; [ -x \"$hook\" ] && \"$hook\" running; echo \"{}\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'hook=\"./hooks/scripts/claude-status-hook.sh\"; [ -x \"$hook\" ] && \"$hook\" running; echo \"{}\"'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
